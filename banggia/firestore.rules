rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /priceLists/current {
      // Trang khách chỉ được đọc bảng giá đã công bố.
      allow get: if true;
      allow list: if false;

      // THAY CHUỖI NÀY BẰNG Firebase Auth UID của quản trị viên sau khi đăng nhập Google.
      // Tuyệt đối không dùng email tự khai trong dữ liệu để quyết định quyền.
      allow create, update: if request.auth != null
        && request.auth.uid == 'REPLACE_WITH_ADMIN_FIREBASE_UID'
        && request.resource.data.keys().hasOnly(['items', 'updatedAt'])
        && request.resource.data.keys().hasAll(['items', 'updatedAt'])
        && request.resource.data.items is list
        && request.resource.data.items.size() <= 1500
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    // Mặc định chặn truy cập mọi tài liệu khác.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
